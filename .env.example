# ─── Environment ────────────────────────────────────────────────
APP_ENV=development                # development | production
LOG_LEVEL=DEBUG                    # DEBUG | INFO | WARNING

# ─── Server ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*                     # comma-separated origins in prod

# ─── Scraper ────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=24
REQUEST_TIMEOUT=30
REQUEST_DELAY=2
MAX_PAGES=3

# ─── OpenAI / LLM ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RETRIES=2

# ─── Extraction Guardrails ──────────────────────────────────────
MAX_DEATHS_PER_EVENT=50
MAX_INJURIES_PER_EVENT=200

# ─── Database (optional overrides) ──────────────────────────────
# DATA_DIR=./data
# DB_PATH=./data/accidents.db
