# ─── Production Environment ─────────────────────────────────────
APP_ENV=production
LOG_LEVEL=WARNING

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://yourdomain.com

# Scraper
SCRAPE_INTERVAL_HOURS=6
REQUEST_TIMEOUT=30
REQUEST_DELAY=2
MAX_PAGES=5

# Database (override to use a persistent volume)
# DATA_DIR=/app/data
# DB_PATH=/app/data/accidents.db
